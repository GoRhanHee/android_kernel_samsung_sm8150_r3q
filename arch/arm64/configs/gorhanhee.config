# Disable Samsung anti-root protection
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_RKP_KDP=n
CONFIG_RKP_NS_PROT=n
CONFIG_RKP_DMAP_PROT=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n

CONFIG_RKP_CFP=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_JOPP_MAGIC=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP_ROPP_SYSREGKEY=n

CONFIG_SECURITY_DEFEX=n
CONFIG_FIVE=n
CONFIG_PROCA=n

# Disable ass error
CONFIG_CC_STACKPROTECTOR=n
# CONFIG_CC_STACKPROTECTOR_NONE is not set
# CONFIG_CC_STACKPROTECTOR_REGULAR is not set
CONFIG_CC_STACKPROTECTOR_STRONG=n

# Local Version
CONFIG_LOCALVERSION="-GoRhanHee_Kernel_sm8250"
CONFIG_LOCALVERSION_AUTO=n

# Enable OVERLAY_FS
CONFIG_OVERLAY_FS=y

# Default Disabled KernelSU
CONFIG_KSU=n